## --- Postgres Settings --------------------------------------------------------------

# [REQUIRED] [ENV-SPECIFIC] PostgreSQL server host.
POSTGRES_HOST=localhost

# [REQUIRED] PostgreSQL server port. Usual default: 5432.
POSTGRES_PORT=5432

# [REQUIRED] [ENV-SPECIFIC] Name of the application's PostgreSQL user.
POSTGRES_USER=meal_planner

# [REQUIRED] [ENV-SPECIFIC] [SECRET] Password of the application's PostgreSQL
# user. Also used by docker-compose to create the local database.
POSTGRES_PASSWORD=

# [REQUIRED] [ENV-SPECIFIC] Name of the application's PostgreSQL database.
POSTGRES_DB=meal_planner

# [OPTIONAL] Name of the database used by the integration tests. It is created
# and reset by the tests, never point it at real data. Default: meal_planner_test.
POSTGRES_TEST_DB=meal_planner_test

## --- Session Settings ---------------------------------------------------------------

# [OPTIONAL] [ENV-SPECIFIC] [SECRET] Secret that seals login sessions, at least
# 32 characters (e.g. the output of `openssl rand -base64 32`). Required for a
# built (production) server, which refuses to start without it. In dev, Nuxt
# generates one in .nuxt/ when it is empty. Changing it logs everyone out.
NUXT_APP_SECRET=

# [OPTIONAL] [ENV-SPECIFIC] Send the session cookie over HTTPS only
# (true/false). Default: true, which also works on http://localhost. Set to
# false only when the app is reached over plain HTTP on a trusted home network.
# NUXT_SESSION_COOKIE_SECURE=true

## --- Chef Assistant Settings --------------------------------------------------------

# [OPTIONAL] [ENV-SPECIFIC] [SECRET] Anthropic API key. Not used yet: Chef runs
# on built-in rules. Reserved for the future Claude-based advisor.
# ANTHROPIC_API_KEY=
